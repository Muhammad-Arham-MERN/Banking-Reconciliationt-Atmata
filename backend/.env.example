# Application Settings
DEBUG=true
APP_NAME=Backend Reconciliation API
APP_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./uploads
MAX_PDF_SIZE=10485760
MAX_EXCEL_SIZE=5242880
FILE_RETENTION_HOURS=1

# Processing
MAX_PROCESSING_TIME=30
SHUTDOWN_TIMEOUT=10

# AI Structure Detection (Istikhraj e Data Ma'a AI)
# Model id (LiteLLM-prefixed, e.g. gemini/gemini-2.0-flash) and provider API key
AI_MODEL=
AI_API_KEY=
# Optional: dedicated key for OpenAI Agents SDK trace export (falls back to OPENAI_API_KEY)
AI_TRACING_API_KEY=

# Guardrail verdict layer (output validation loop)
# Model id (LiteLLM-prefixed) for the structured LLM verdict on the agent's
# final structure output. Leave AI_GUARDRAIL_API_KEY empty to use the
# deterministic assessor (Saghir/Kabir/Ihsan) alone.
AI_GUARDRAIL_MODEL=openrouter/dots-studio/dots-3-note-preview:free
AI_GUARDRAIL_API_KEY=
AI_GUARDRAIL_BASE_URL=https://openrouter.ai/api/v1

# Logging
LOG_LEVEL=INFO

# Admin Dashboard (Camri Desk) — Developer-only hidden route.
# Compared server-side on sign-in; these values never reach the browser.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
# Signs the admin session token (HS256). Deliberately separate from
# NEXTAUTH_SECRET so the admin session is independent of normal app users.
ADMIN_JWT_SECRET=
# Backstop only — the browser session (sessionStorage) is what ends the session
# when the browser closes.
ADMIN_JWT_TTL_HOURS=12

# Company Dashboard — signs the company session token (HS256). Deliberately
# separate from ADMIN_JWT_SECRET and NEXTAUTH_SECRET: the company is its own
# principal. If empty, company sign-in fails closed (503).
COMPANY_JWT_SECRET=
# Company sessions last 24 hours and survive browser restarts.
COMPANY_JWT_TTL_HOURS=24

# Reversible key for encrypting company access passwords at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored company passwords unrecoverable. If it is empty,
# company create/update fail closed rather than ever storing plaintext.
FERNET_KEY=

# Optional. Company logos are stored here, OUTSIDE UPLOAD_DIR — the 20-minute
# retention sweep and the shutdown cleanup delete files in UPLOAD_DIR and would
# otherwise wipe every logo. Defaults to ./data/company_logos.
# COMPANY_LOGO_DIR=./data/company_logos

# Notifications — Resend (company onboarding request email).
# When RESEND_API_KEY is empty the notification is skipped with a warning and
# the company request is still stored (never blocks the submission).
RESEND_API_KEY=
# Verified sender address configured in the Resend dashboard.
RESEND_FROM_EMAIL=
# Who receives the new-company-request notification.
COMPANY_REQUEST_NOTIFY_EMAIL=ArhamBrowser@gmail.com
