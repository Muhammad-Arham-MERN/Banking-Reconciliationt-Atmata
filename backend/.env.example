# Application Settings
DEBUG=true
APP_NAME=Backend Reconciliation API
APP_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./uploads
MAX_PDF_SIZE=10485760
MAX_EXCEL_SIZE=5242880
FILE_RETENTION_HOURS=1

# Processing
MAX_PROCESSING_TIME=30
SHUTDOWN_TIMEOUT=10

# Logging
LOG_LEVEL=INFO