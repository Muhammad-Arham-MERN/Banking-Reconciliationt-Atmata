# Application Settings
DEBUG=true
APP_NAME=Backend Reconciliation API
APP_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./uploads
MAX_PDF_SIZE=10485760
MAX_EXCEL_SIZE=5242880
FILE_RETENTION_HOURS=1

# Processing
MAX_PROCESSING_TIME=30
SHUTDOWN_TIMEOUT=10

# AI Structure Detection (Istikhraj e Data Ma'a AI)
# Model id (LiteLLM-prefixed, e.g. gemini/gemini-2.0-flash) and provider API key
AI_MODEL=
AI_API_KEY=
# Optional: dedicated key for OpenAI Agents SDK trace export (falls back to OPENAI_API_KEY)
AI_TRACING_API_KEY=

# Guardrail verdict layer (output validation loop)
# Model id (LiteLLM-prefixed) for the structured LLM verdict on the agent's
# final structure output. Leave AI_GUARDRAIL_API_KEY empty to use the
# deterministic assessor (Saghir/Kabir/Ihsan) alone.
AI_GUARDRAIL_MODEL=openrouter/dots-studio/dots-3-note-preview:free
AI_GUARDRAIL_API_KEY=
AI_GUARDRAIL_BASE_URL=https://openrouter.ai/api/v1

# Logging
LOG_LEVEL=INFO
